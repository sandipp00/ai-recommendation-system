# Optional model configuration
RECOMMENDATION_DATASET=data/raw/sample_movies.csv
SEMANTIC_MODEL=all-MiniLM-L6-v2
LLM_MODEL=EleutherAI/gpt-neo-125M

# Streamlit uses this when running outside Docker.
API_URL=http://127.0.0.1:8000

# Azure deployment placeholders (set outside Git)
AZURE_RESOURCE_GROUP=rg-ai-recommendation
AZURE_CONTAINER_REGISTRY=<UNIQUE_ACR_NAME>
AZURE_LOCATION=centralindia
